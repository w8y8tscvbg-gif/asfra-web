# Where form submissions (quotes and agency registrations) are sent as a JSON POST.
# Any endpoint works: Zapier/Make webhook, Google Apps Script web app, CRM webhook...
# REQUIRED in production: without it the forms show an error and point visitors to WhatsApp.
LEAD_WEBHOOK_URL=

# Optional. If set, sent as "Authorization: Bearer <value>" to the webhook.
LEAD_WEBHOOK_SECRET=
